const types = ['All', 'Achievement', 'Certification', 'Leadership', 'Recognition'];
---

<BaseLayout
  title="Achievements"
  description="Certifications, milestones and achievements of Yokeswaran MP"
>
  <section class="max-w-4xl mx-auto px-6 py-24">

    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4"
          style="color: var(--color-foreground);">
        Achievements
      </h1>
      <div class="w-16 h-1 rounded-full"
           style="background-color: var(--color-primary);"></div>
      <p class="mt-4 text-lg" style="color: #94a3b8;">
        Certifications, milestones and things I'm proud of.
      </p>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      {[
        { number: '5+', label: 'Years at TCS' },
        { number: '15+', label: 'Certifications' },
        { number: '230+', label: 'Mentored' },
        { number: '1000+', label: 'Students Empowered' },
      ].map(stat => (
        <div class="card text-center space-y-1">
          <p class="text-3xl font-bold" style="color: var(--color-primary);">{stat.number}</p>
          <p class="text-xs" style="color: #64748b;">{stat.label}</p>
        </div>
      ))}
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap gap-3 mb-10" id="filter-buttons">
      {types.map(type => (
        <button
          class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer"
          data-type={type}
          style={type === 'All'
            ? 'background-color: var(--color-primary); color: white;'
            : 'background-color: #1e293b; color: #94a3b8; border: 1px solid #334155;'}
        >
          {type}
        </button>
      ))}
    </div>

    <!-- Timeline -->
    <div class="relative space-y-6" id="achievements-list">

      <!-- Timeline Line -->
      <div class="absolute left-8 top-0 bottom-0 w-px"
           style="background-color: #1e293b;"></div>

      {achievements.map(item => (
        <div
          class="relative flex gap-6 pl-20 achievement-item"
          data-type={item.type}
        >
          <!-- Icon -->
          <div class="absolute left-0 w-16 h-16 rounded-2xl flex items-center justify-center text-2xl shrink-0"
               style="background-color: #1e293b; border: 1px solid #334155;">
            {item.icon}
          </div>

          <!-- Content -->
          <div class="card flex-1 space-y-3">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <span class="px-3 py-1 rounded-full text-xs font-medium"
                    style={`background-color: #0f172a; border: 1px solid;
                    ${item.type === 'Achievement' ? 'color: #22c55e; border-color: #22c55e;' :
                      item.type === 'Certification' ? 'color: #6366f1; border-color: #6366f1;' :
                      item.type === 'Leadership' ? 'color: #f59e0b; border-color: #f59e0b;' :
                      'color: #ec4899; border-color: #ec4899;'}`}>
                {item.type}
              </span>
              <span class="text-sm font-medium" style="color: #64748b;">{item.year}</span>
            </div>
            <h3 class="text-lg font-bold" style="color: var(--color-foreground);">
              {item.title}
            </h3>
            <p class="text-sm leading-relaxed" style="color: #94a3b8;">
              {item.description}
            </p>
          </div>
        </div>
      ))}

    </div>

    <!-- Recommendations Section -->
    <div class="mt-20">
      <h2 class="text-2xl font-bold mb-8" style="color: var(--color-foreground);">
        What People Say
      </h2>

      <div class="grid md:grid-cols-2 gap-6">
        {[
          {
            name: "Glenn Lau",
            role: "Senior Manager, CRM Operations – Rogers Communications",
            text: "Yokes is one of my most trusted IT partners. He always steps into the shoes of the business when investigating issues. Not only an exceptional problem solver, but manages any issue with strong end-to-end ownership.",
            year: "2025"
          },
          {
            name: "HariKrishna Aranga",
            role: "SAS Architect | AWS | Kubernetes",
            text: "Yokeswaran is very attentive to details, has keen interest in understanding architecture and implementation details. I feel confident delegating activities knowing he does the due diligence and mentors new members efficiently.",
            year: "2023"
          },
          {
            name: "Milind Wankhede",
            role: "Clinical Business Systems Senior Analyst",
            text: "Yokes is very hardworking and sincere towards his work. He shows enthusiasm to learn new technologies and take new responsibilities. He learned SAS and gained expertise in a short time.",
            year: "2023"
          },
          {
            name: "Mark Anthony Claramo",
            role: "BI Analyst – Data Analysis & Modeling",
            text: "It's been good working with Yokes. He helped me investigate data ETL in a timely manner. He makes sure he can deliver results as soon as possible even if it needs manual data checks.",
            year: "2023"
          },
        ].map(rec => (
          <div class="card space-y-4">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold shrink-0"
                   style="background: linear-gradient(135deg, #6366f1, #22c55e); color: white;">
                {rec.name.charAt(0)}
              </div>
              <div>
                <p class="font-semibold text-sm" style="color: var(--color-foreground);">{rec.name}</p>
                <p class="text-xs" style="color: #64748b;">{rec.role}</p>
              </div>
              <span class="ml-auto text-xs" style="color: #64748b;">{rec.year}</span>
            </div>
            <p class="text-sm leading-relaxed italic" style="color: #94a3b8;">
              "{rec.text}"
            </p>
            <div class="flex gap-1">
              {[1,2,3,4,5].map(() => (
                <span style="color: #f59e0b;">★</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

  </section>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.achievement-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-type');

      filterBtns.forEach(b => {
        b.setAttribute('style',
          'background-color: #1e293b; color: #94a3b8; border: 1px solid #334155;'
        );
      });
      btn.setAttribute('style',
        'background-color: var(--color-primary); color: white;'
      );

      items.forEach(item => {
        const type = item.getAttribute('data-type');
        const show = selected === 'All' || type === selected;
        (item as HTMLElement).style.display = show ? 'flex' : 'none';
      });
    });
  });
</script>
