    title: "Google Cloud Platform Certifications",
    description: "Completed GCP Big Data and Machine Learning Fundamentals, GCP Core Infrastructure, and BigQuery Data Preparation certifications from Coursera.",
    icon: "🌐",
    type: "Certification",
  },
  {
    year: "2020",
    title: "DevOps Fundamentals – TCS",
    description: "Completed DevOps Fundamentals certification from Tata Consultancy Services, establishing strong foundation in CI/CD pipelines and DevOps practices.",
    icon: "🔧",
    type: "Certification",
  },
  {
    year: "2021",
    title: "HackerEarth Campus Ambassador",
    description: "Served as Campus Ambassador for HackerEarth for 3 years. Organized hackathons including RVS CODIUM and CODE ZAPPIES, empowering over 1,000 students to enhance their coding skills.",
    icon: "🏆",
    type: "Leadership",
  },
  {
    year: "2020",
    title: "Best Outgoing Student – B.Sc IT, RVSCAS",
    description: "Honoured as the Best Outgoing Student of the year for B.Sc Information Technology at Rathnavel Subramaniam College of Arts and Science, associated with Bharathiar University (2017–2020).",
    icon: "🎓",
    type: "Recognition",
  },
   {
    year: "2018",
    title: "Winner – RVS CODIUM '18",
    description: "Won a global-level online coding competition conducted by HackerEarth Campus Ambassadors of RVS College of Arts and Science, supported by Facebook Developer Circles and GDG Coimbatore.",
    icon: "🥇",
    type: "Recognition",
  },
