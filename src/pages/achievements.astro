  },
  {
    year: "2025",
    title: "Client Recommendation – Rogers Communications",
    description: "Received glowing recommendation from Glenn Lau, Senior Manager at Rogers Communications: 'Yokes is one of my most trusted IT partners — an exceptional problem solver with strong end-to-end ownership.'",
    icon: "⭐",
    type: "Recognition",
  },
  {
    year: "2025",
    title: "ETL and Data Pipelines – Coursera",
    description: "Completed ETL and Data Pipelines with Shell, Airflow and Kafka certification. Skills: Apache Kafka, Airflow, DAG, Shell Scripting, Python.",
    icon: "🔄",
